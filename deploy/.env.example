# Copy to deploy/.env (never committed) and fill in the secrets.
# docs/operations/ describes every variable.

# `local` adds Keycloak and Mailpit for evaluation and tests. Leave it empty
# in production, where your own identity provider and mail relay serve.
COMPOSE_PROFILES=local

# Public URLs: <scheme>://[convex.|convex-site.|convex-dashboard.|keycloak.|mail.]<domain>:<port>
# `netplan.localhost` resolves to this machine in browsers with no DNS change.
NETPLAN_SCHEME=http
NETPLAN_DOMAIN=netplan.localhost
NETPLAN_PORT=8480
# The address the edge listens on. 0.0.0.0 exposes it to the network.
NETPLAN_BIND_ADDRESS=127.0.0.1

# Secrets. Generate each with `openssl rand -hex 32`.
POSTGRES_PASSWORD=
# The Convex backend's admin keys derive from it. Keep it with the backups.
INSTANCE_SECRET=
# Keycloak's `admin` user (profile `local` only).
KEYCLOAK_ADMIN_PASSWORD=

# Convex function variables (deploy/convex-env.txt). Applied by
# `convex-deploy` on every start; an empty value is left as it is.
NETBOX_URL=
NETBOX_TOKEN=
LIBRENMS_URL=
LIBRENMS_TOKEN=
NETPLAN_CONNECTOR_SECRET=
INTEGRATION_SCHEDULER_ENABLED=
INTEGRATION_MANUAL_REFRESH_ENABLED=
ALLOW_DEV_SEED=
