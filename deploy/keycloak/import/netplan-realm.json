{
  "realm": "netplan",
  "displayName": "Netplan (local)",
  "enabled": true,
  "loginWithEmailAllowed": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "netplan-editor",
        "description": "Granted Éditeur once an admin maps it in Netplan."
      },
      {
        "name": "netplan-admin",
        "description": "Granted Admin once an admin maps it in Netplan."
      }
    ]
  },
  "clients": [
    {
      "clientId": "netplan",
      "name": "Netplan",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "netplan-local",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://netplan.localhost:8480/api/auth/oauth2/callback/keycloak",
        "http://127.0.0.1:*",
        "http://localhost:*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    }
  ],
  "users": [
