{
  "name": "netplan-create",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently 'bun run db' 'bun run web'",
    "web": "vite dev",
    "db": "convex dev",
    "build": "vite build",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run codegen:check",
    "bench:engine": "bun run scripts/bench-engine.ts",
    "perf:render": "PERF_STATS_LOG=1 bun test test/perf/renderCounts.test.tsx",
    "lint:fix": "oxlint --fix --deny-warnings",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit --pretty",
    "test": "bun test",
    "codegen:check": "bun scripts/codegen-check.ts",
    "fix": "bun run lint:fix && bun run format",
    "verify": "bun run check && bun run build && git diff --exit-code -- src/routeTree.gen.ts",
    "dev:agent": "bun scripts/dev-agent.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.5",
    "better-auth": "1.6.33",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.128",
    "nodemailer": "^10.1.1",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@happy-dom/global-registrator": "^21.0.1",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.169.2",
    "@tanstack/react-virtual": "^3.14.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^10.0.6",
    "convex-test": "^0.0.62",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.1",
    "mitata": "^1.0.34",
    "nitro": "3.0.260903-beta",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-scan": "^0.5.7",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
